# ==============================================================================
# ARCA - Environment Variables Template
# ==============================================================================
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit your actual .env file to Git. (.env is ignored by .gitignore)
# 2. Variables prefixed with VITE_ are public and bundled into client JavaScript.
# 3. Backend secrets (GEMINI_API_KEY, ELEVENLABS_API_KEY, etc.) must NEVER have
#    the VITE_ prefix.
# 4. In production, inject server secrets securely via the Vercel Dashboard:
#    Project Settings -> Environment Variables -> Mark as Sensitive.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE ENVIRONMENT VARIABLES (Public / Bundled by Vite)
# ------------------------------------------------------------------------------
# Firebase Web Client Configuration (Restricted by domain in Google Cloud Console)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=arca-budgeting.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=arca-budgeting
VITE_FIREBASE_STORAGE_BUCKET=arca-budgeting.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Optional: Custom API Base URL (leave empty for same-origin relative /api)
VITE_API_BASE_URL=

# Primary Production Domain (used for CORS allowlist and landing app links)
CLIENT_ORIGIN=https://arcabudgeting.com
VITE_APP_URL=https://arcabudgeting.com

# ElevenLabs Conversational Widget Agent ID (Public Client Identifier)
VITE_ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id

# AWS Infrastructure Endpoints (Public API Gateway)
VITE_AWS_HTTP_ENDPOINT=https://your-api-id.execute-api.region.amazonaws.com
VITE_AWS_WS_ENDPOINT=wss://your-ws-id.execute-api.region.amazonaws.com/prod

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE SECRETS (Private - NEVER prefix with VITE_)
# ------------------------------------------------------------------------------
# These keys are accessed ONLY by backend serverless endpoints (/api/*) and
# local Express server (node server/index.js). They will never reach the browser.

# Google Gemini AI (Required for Assistant, Voice transcription, and Receipt scanning)
GEMINI_API_KEY=your_gemini_api_key

# ElevenLabs Voice & Audio (Required for server-side Text-to-Speech)
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Optional Vision Fallbacks
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Server Port (Local development)
PORT=5000
